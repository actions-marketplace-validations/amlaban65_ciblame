{
  "version": 1,
  "signatures": [
    {
      "id": "copilot-code-review",
      "name": "Copilot code review",
      "kind": "agent",
      "vendor": "GitHub",
      "workflow_paths": [
        "copilot-pull-request-reviewer"
      ],
      "notes": "Since 2026-06-01 Copilot code review on private repos runs as dynamic/agents/copilot-pull-request-reviewer and consumes Actions minutes."
    },
    {
      "id": "github-advanced-security",
      "name": "Code scanning AI (GHAS)",
      "kind": "agent",
      "vendor": "GitHub",
      "workflow_paths": [
        "dynamic/agents/github-advanced-security"
      ],
      "logins": [
        "github-advanced-security[bot]"
      ],
      "notes": "Runs named 'Code scanning AI findings on PR #N'."
    },
    {
      "id": "copilot",
      "name": "GitHub Copilot",
      "kind": "agent",
      "vendor": "GitHub",
      "workflow_paths": [
        "copilot-swe-agent"
      ],
      "logins": [
        "Copilot",
        "copilot-swe-agent[bot]",
        "copilot-swe-agent"
      ],
      "branch_prefixes": [
        "copilot/"
      ],
      "trailers": [
        "^co-authored-by:\\s*copilot(?:-swe-agent)?(?:\\[bot\\])?\\s*<"
      ],
      "emails": [
        "223556219+Copilot@users.noreply.github.com",
        "198982749+Copilot@users.noreply.github.com"
      ],
      "notes": "Copilot coding agent sessions, PRs opened by Copilot, and commits co-authored by Copilot."
    },
    {
      "id": "claude-code",
      "name": "Claude Code",
      "kind": "agent",
      "vendor": "Anthropic",
      "logins": [
        "claude[bot]"
      ],
      "branch_prefixes": [
        "claude/"
      ],
      "emails": [
        "noreply@anthropic.com"
      ],
      "body_patterns": [
        "generated with \\[?claude code"
      ]
    },
    {
