    {
      "id": "gh-aw",
      "name": "GitHub Agentic Workflows",
      "kind": "agent",
      "vendor": "GitHub",
      "workflow_path_suffixes": [
        ".lock.yml"
      ],
      "body_patterns": [
        "<!--\\s*gh-aw-agentic-workflow:"
      ],
      "notes": "gh aw compiles Markdown workflows into .lock.yml files; runs of those files are the agent itself executing. PRs it opens are authored by github-actions[bot] and carry a gh-aw-agentic-workflow marker."
    },
